{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "strands-kamada-hono",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-04",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"ENVIRONMENT": "production",
		"AWS_REGION": "ap-northeast-1",
		"BETTER_AUTH_URL": "https://strands-kamada-hono.kmdworksnative.workers.dev"
	},
	"secrets": {
		"required": [
			"AWS_ACCESS_KEY_ID",
			"AWS_SECRET_ACCESS_KEY",
			"AGENTCORE_RUNTIME_ARN",
			"BETTER_AUTH_SECRET"
		]
	},
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./public",
		"run_worker_first": [
			"/api/*",
			"/internal/*",
			"/aircon"
		]
	},
	"d1_databases": [
		{
			"binding": "AUTH_DB",
			"database_name": "strands-kamada-auth",
			"database_id": "d69eacf3-66d8-435d-8a69-e11297172895",
			"migrations_dir": "migrations",
		}
	]
}
